# ==========================================
# Docker Ignore File - Cleaning One Backend
# ==========================================

# --- Version Control ---
.git
.gitignore
.gitattributes
.github

# --- Virtual Environments & Package Managers ---
.venv
venv/
env/
ENV/
.uv/
uv.cache/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# --- Uploads & Static Media ---
uploads/*
!uploads/.gitkeep
media/*
!media/.gitkeep
static/uploads/*
!static/uploads/.gitkeep

# --- Machine Learning & Checkpoints ---
*.pt
*.pth
*.onnx
*.bin
*.h5
checkpoints/
model_weights/

# --- Logs & Local Databases ---
*.log
logs/
*.sqlite3
*.db
mongo_dump/
dump/

# --- Test, Linting & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.hypothesis/
tests/

# --- IDE & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Local Utility / Temporary / Scratch Files ---
scratch/
tmp/
temp/
*.tmp
*.temp
check.py
mock.py
get_otp.py
get_token.py
update_admin_routes.py
walkthrough.md
start
start.bat
start.ps1

# --- Docker & CI/CD Configs ---
Dockerfile*
docker-compose*.yml
.dockerignore
